# ==============================================================================
# TrustLayer-AI Configuration Environment Template
# ==============================================================================
# Copy this file to .env before starting the backend:
#   cp .env.example .env
# ==============================================================================

# --- Active Storage Engine ---
# Options for DATA_BACKEND: 'csv' (Zero external dependencies) or 'postgres'
DATA_BACKEND=csv

# Options for VECTOR_BACKEND: 'chroma' (Zero external dependencies) or 'pgvector'
VECTOR_BACKEND=chroma

# PostgreSQL Connection String (Required only if DATA_BACKEND=postgres or VECTOR_BACKEND=pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustlayer_db

# --- Local File Paths ---
CSV_DATASET_PATH=data/exports/final_hotel_dataset.csv
BATCH_DEBUG_FILE_PATH=data/exports/batch_debug_results.json
VECTOR_STORE_PATH=data/vector_store

# --- LLM & Embedding Settings ---
LLM_PROVIDER=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Operational Limits & Quality Gates ---
RETRIEVAL_TOP_K=10
CANDIDATE_POOL_SIZE=50
QUALITY_GATE_TRUST_THRESHOLD=70.0
MAX_BATCH_QUERIES=100
CACHE_TTL_SECONDS=3600

# --- External Ingestion APIs (Optional - for running raw fetch pipelines) ---
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# --- Frontend API Endpoint ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
